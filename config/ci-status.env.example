# Copy to ~/.config/ci-status.env and customize.
# install.sh creates ~/.config/ci-status.env from this file on first run.
# Só repos ERP-Flow-Sistemas com GitHub Actions (workflows > 0).

ORG=ERP-Flow-Sistemas
REPOS=(
  flow-api-tenant flow-api-cadastros flow-api-produtos flow-api-estoque
  flow-api-fiscal flow-api-pagamentos flow-api-financeiro flow-api-automacao
  flow-api-pista flow-frontend flow-pdv flow-pdv-mobile flow-ops
)
